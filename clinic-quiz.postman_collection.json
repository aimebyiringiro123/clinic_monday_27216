{
  "info": {
    "name": "Clinic JPA JPQL Quiz",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "doctorId", "value": "" },
    { "key": "patientId", "value": "" }
  ],
  "item": [
    {
      "name": "A1 Patients by last name",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/patients/by-last-name?lastName=uwase"
      }
    },
    {
      "name": "A2 Appointments by status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/appointments/by-status?status=SCHEDULED"
      }
    },
    {
      "name": "A3 Appointments in date range",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/appointments/between?start=2026-10-01&end=2026-10-31"
      }
    },
    {
      "name": "A4 No double booking",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appointmentDate\": \"2026-10-20\",\n  \"reason\": \"Should conflict\",\n  \"status\": \"SCHEDULED\",\n  \"patient\": { \"id\": \"{{patientId}}\" },\n  \"doctor\": { \"id\": \"{{doctorId}}\" }\n}"
        },
        "url": "{{baseUrl}}/api/appointments/save"
      }
    },
    {
      "name": "B1 Doctors by specialization",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/doctors/by-specialization?name=cardiology"
      }
    },
    {
      "name": "B2 Doctors without office",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/doctors/without-office"
      }
    },
    {
      "name": "B3 Unused specializations",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/specializations/unused"
      }
    },
    {
      "name": "B4 Patients of a doctor",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/patients/of-doctor/{{doctorId}}"
      }
    },
    {
      "name": "C1 Appointments per status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/appointments/stats/by-status"
      }
    },
    {
      "name": "C2 Frequent patients",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/patients/frequent?min=3"
      }
    },
    {
      "name": "C3 Busiest office",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/offices/busiest"
      }
    },
    {
      "name": "C4 Cancel day",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/appointments/cancel-day?doctorId={{doctorId}}&date=2026-10-20"
      }
    },
    {
      "name": "Bonus page",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/appointments/page?page=0&size=5&sort=appointmentDate,desc"
      }
    },
    {
      "name": "Bonus delete cancelled before",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/appointments/cancelled-before?date=2026-10-15"
      }
    }
  ]
}
